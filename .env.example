POCKETBASE_URL=https://pocketbase-production-6ab5.up.railway.app/
POCKETBASE_ADMIN_EMAIL=email
POCKETBASE_ADMIN_PASSWORD=pass

FLI_TOKEN=token

DEMO_USER=email
DEMO_PASSWORD=pass

# Walkthrough narration (scripts/walkthroughs; real values go in .env, which is git-ignored)
ELEVENLABS_API_KEY=key
ELEVENLABS_VOICE_ID=voice_id

# Email delivery (Settings status indicator checks these values)
# You can use either SMTP_* or MAIL_* naming.

# SMTP_* format
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASS=super-secret-password
SMTP_FROM=no-reply@example.com

# MAIL_* format (alternative provider naming)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=